}

model UserAlbum {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  collectionId       String    @map("collection_id") @db.Uuid
  albumId            String    @map("album_id") @db.Uuid
  isFavorite         Boolean   @default(false) @map("is_favorite")
  progressPercentage Decimal   @default(0) @map("progress_percentage") @db.Decimal(5, 2)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_albums_collection_id")
  album      Album      @relation(fields: [albumId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_albums_album_id")

