enum SellerVerificationStatus {
  UNDER_REVIEW
  PENDING
  APPROVED
  REJECTED

  @@map("seller_verification_status")
}

model SellerVerification {
  id                     String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                 String                   @unique @map("user_id") @db.Uuid
  reviewedById           String?                  @map("reviewed_by_id") @db.Uuid
  addressId              String?                  @map("address_id") @db.Uuid
  status                 SellerVerificationStatus @default(UNDER_REVIEW)
  legalName              String                   @map("legal_name") @db.VarChar(160)
  tradeName              String?                  @map("trade_name") @db.VarChar(160)
  cnpj                   String                   @unique @db.VarChar(18)
  stateRegistration      String?                  @map("state_registration") @db.VarChar(30)
  openingDate            DateTime?                @map("opening_date") @db.Date
  companySize            String?                  @map("company_size") @db.VarChar(40)
  cnae                   String?                  @db.VarChar(120)
  responsibleName        String                   @map("responsible_name") @db.VarChar(120)
  responsibleCpf         String                   @map("responsible_cpf") @db.VarChar(14)
  responsiblePhone       String?                  @map("responsible_phone") @db.VarChar(20)
  bankName               String?                  @map("bank_name") @db.VarChar(80)
  bankBranch             String?                  @map("bank_branch") @db.VarChar(10)
  bankAccount            String?                  @map("bank_account") @db.VarChar(20)
  pixKey                 String?                  @map("pix_key") @db.VarChar(120)
  rejectionReason        String?                  @map("rejection_reason") @db.VarChar(255)
  regularizationDeadline DateTime?                @map("regularization_deadline") @db.Timestamptz(6)
  reviewedAt             DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?                @map("deleted_at") @db.Timestamptz(6)

  seller    User                     @relation("SellerVerificationSeller", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_seller_verifications_user_id")
  reviewer  User?                    @relation("SellerVerificationReviewer", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_seller_verifications_reviewed_by_id")
  address   Address?                 @relation(fields: [addressId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_seller_verifications_address_id")
  documents SellerDocument[]
  notes     SellerVerificationNote[]

  @@map("seller_verifications")
}

