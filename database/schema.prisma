generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum CategoryType {
  ALBUM
  CARD

  @@map("category_type")
}

enum AlbumStatus {
  ACTIVE
  INACTIVE

  @@map("album_status")
}

model User {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String     @db.VarChar(120)
  email         String     @unique @db.VarChar(160)
  passwordHash  String?    @map("password_hash") @db.VarChar(255)
  role          UserRole
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false) @map("email_verified")
  termsAccepted Boolean    @default(false) @map("terms_accepted")
  oauthProvider String?    @map("oauth_provider") @db.VarChar(30)
  oauthId       String?    @map("oauth_id") @db.VarChar(120)
  phone         String?    @db.VarChar(20)
  username      String?    @unique @db.VarChar(30)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  updatedSettings     GlobalSetting[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], map: "fk_refresh_tokens_user_id")

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  used      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], map: "fk_password_reset_tokens_user_id")

  @@map("password_reset_tokens")
}

model AuditLog {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  action     String    @db.VarChar(90)
  entityType String    @map("entity_type") @db.VarChar(60)
  entityId   String?   @map("entity_id") @db.Uuid
  details    Json?     @db.JsonB
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  admin User @relation(fields: [adminId], references: [id], map: "fk_audit_logs_admin_id")

  @@map("audit_logs")
}

model GlobalSetting {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  key         String    @unique @db.VarChar(90)
  value       String    @db.Text
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id], map: "fk_global_settings_updated_by_id")

  @@map("global_settings")
}

model Category {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parentCategoryId String?      @map("parent_category_id") @db.Uuid
  name             String       @db.VarChar(90)
  type             CategoryType
  description      String?      @db.VarChar(255)
  isDefault        Boolean      @default(false) @map("is_default")
  slug             String       @unique @db.VarChar(100)
  displayOrder     Int          @default(0) @map("display_order")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], map: "fk_categories_parent_category_id")
  children Category[] @relation("CategoryHierarchy")
  albums   Album[]
  cards    Card[]

  @@map("categories")
}

model Rarity {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String    @unique @db.VarChar(60)
  sortOrder Int       @map("sort_order") @db.SmallInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  cards Card[]

  @@map("rarities")
}

model Language {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String    @db.VarChar(60)
  code      String    @unique @db.VarChar(5)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  cards Card[]

  @@map("languages")
}

model Album {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId  String?     @map("category_id") @db.Uuid
  title       String      @db.VarChar(160)
  publisher   String?     @db.VarChar(120)
  year        Int?        @db.SmallInt
  description String?     @db.Text
  coverUrl    String?     @map("cover_url") @db.VarChar(255)
  totalCards  Int         @default(0) @map("total_cards")
  status      AlbumStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id], map: "fk_albums_category_id")
  cards    Card[]

  @@map("albums")
}

model Card {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  albumId       String?   @map("album_id") @db.Uuid
  categoryId    String?   @map("category_id") @db.Uuid
  rarityId      String?   @map("rarity_id") @db.Uuid
  languageId    String?   @map("language_id") @db.Uuid
  name          String    @db.VarChar(160)
  number        String?   @db.VarChar(20)
  description   String?   @db.Text
  frontImageUrl String?   @map("front_image_url") @db.VarChar(255)
  backImageUrl  String?   @map("back_image_url") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  album    Album?    @relation(fields: [albumId], references: [id], map: "fk_cards_album_id")
  category Category? @relation(fields: [categoryId], references: [id], map: "fk_cards_category_id")
  rarity   Rarity?   @relation(fields: [rarityId], references: [id], map: "fk_cards_rarity_id")
  language Language? @relation(fields: [languageId], references: [id], map: "fk_cards_language_id")

  @@unique([albumId, number])
  @@map("cards")
}
