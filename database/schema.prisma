  CREDIT_CARD
  PIX
  BOLETO

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED

  @@map("payment_status")
}

enum PriceSource {
  SALE
  LISTING

  @@map("price_source")
}

model Listing {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId          String        @map("seller_id") @db.Uuid
  cardId            String        @map("card_id") @db.Uuid
  conditionId       String?       @map("condition_id") @db.Uuid
  price             Decimal       @db.Decimal(10, 2)
  availableQuantity Int           @default(1) @map("available_quantity")
  description       String?
  status            ListingStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  seller        User           @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_listings_seller_id")
  card          Card           @relation(fields: [cardId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_listings_card_id")
  condition     CardCondition? @relation(fields: [conditionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_listings_condition_id")
  photos        ListingPhoto[]
  orders        Order[]
  groupMessages GroupMessage[]
  reports       Report[]

  @@map("listings")
}

model CardCondition {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String    @unique @db.VarChar(60)
  sortOrder Int       @map("sort_order") @db.SmallInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  listings Listing[]

  @@map("card_conditions")
}

model ListingPhoto {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId String    @map("listing_id") @db.Uuid
  url       String    @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_listing_photos_listing_id")

  @@map("listing_photos")
}

model Order {
  id                 String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId          String      @map("listing_id") @db.Uuid
  buyerId            String      @map("buyer_id") @db.Uuid
  sellerId           String      @map("seller_id") @db.Uuid
  shippingAddressId  String      @map("shipping_address_id") @db.Uuid
  quantity           Int         @default(1)
  itemsAmount        Decimal     @map("items_amount") @db.Decimal(10, 2)
  shippingAmount     Decimal     @default(0) @map("shipping_amount") @db.Decimal(10, 2)
  totalAmount        Decimal     @map("total_amount") @db.Decimal(10, 2)
  shippingMethod     String      @map("shipping_method") @db.VarChar(60)
  status             OrderStatus @default(AWAITING_PAYMENT)
  shippingService    String?     @map("shipping_service") @db.VarChar(60)
  shippingLabelId    String?     @map("shipping_label_id") @db.VarChar(60)
  trackingCode       String?     @map("tracking_code") @db.VarChar(40)
  trackingUrl        String?     @map("tracking_url") @db.VarChar(255)
  platformFee        Decimal?    @map("platform_fee") @db.Decimal(10, 2)
  stripeTransferId   String?     @map("stripe_transfer_id") @db.VarChar(60)
  cancelReason       String?     @map("cancel_reason") @db.VarChar(255)
  problemDescription String?     @map("problem_description") @db.VarChar(500)
  problemReportedAt  DateTime?   @map("problem_reported_at") @db.Timestamptz(6)
  paidAt             DateTime?   @map("paid_at") @db.Timestamptz(6)
  shippedAt          DateTime?   @map("shipped_at") @db.Timestamptz(6)
  deliveredAt        DateTime?   @map("delivered_at") @db.Timestamptz(6)
  releasedAt         DateTime?   @map("released_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(6)

  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_listing_id")
  buyer           User     @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_buyer_id")
  seller          User     @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_seller_id")
  shippingAddress Address  @relation(fields: [shippingAddressId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_shipping_address_id")
  payment         Payment?

  @@map("orders")
}

model Payment {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId          String        @unique @map("order_id") @db.Uuid
  method           PaymentMethod
  value            Decimal       @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  gatewayReference String?       @map("gateway_reference") @db.VarChar(120)
  chargeId         String?       @map("charge_id") @db.VarChar(60)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  refundedAt       DateTime?     @map("refunded_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payments_order_id")

  @@map("payments")
}

model PriceHistory {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cardId        String      @map("card_id") @db.Uuid
  price         Decimal     @db.Decimal(10, 2)
  referenceDate DateTime    @map("reference_date") @db.Date
  source        PriceSource
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(6)

  card Card @relation(fields: [cardId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_price_history_card_id")

  @@map("price_history")
}

model Collection {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  isPublic  Boolean   @default(false) @map("is_public")
  shareLink String?   @unique @map("share_link") @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user   User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_collections_user_id")
  albums UserAlbum[]
