generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED

  @@map("user_status")
}

enum StripeAccountStatus {
  PENDING
  VERIFYING
  READY

  @@map("stripe_account_status")
}

enum Privacy {
  PUBLIC
  PRIVATE

  @@map("privacy")
}

model User {
  id                  String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                String               @db.VarChar(120)
  email               String               @unique @db.VarChar(160)
  passwordHash        String?              @map("password_hash") @db.VarChar(255)
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  emailVerified       Boolean              @default(false) @map("email_verified")
  termsAccepted       Boolean              @default(false) @map("terms_accepted")
  oauthProvider       String?              @map("oauth_provider") @db.VarChar(30)
  oauthId             String?              @map("oauth_id") @db.VarChar(120)
  username            String?              @unique @db.VarChar(30)
  phone               String?              @db.VarChar(20)
  cpf                 String?              @unique @db.VarChar(14)
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp         String?              @map("last_login_ip") @db.VarChar(45)
  suspendedUntil      DateTime?            @map("suspended_until") @db.Timestamptz(6)
  stripeAccountId     String?              @unique @map("stripe_account_id") @db.VarChar(60)
  stripeAccountStatus StripeAccountStatus? @map("stripe_account_status")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)

  profile                         Profile?
  createdGroups                   Group[]
  groupMemberships                GroupMember[]
  authoredGroupMessages           GroupMessage[]
  reportsFiled                    Report[]                 @relation("ReportReporter")
  reportsModerated                Report[]                 @relation("ReportModerator")
  reportsReceived                 Report[]                 @relation("ReportTargetUser")
  catalogRequests                 CatalogRequest[]         @relation("CatalogRequestRequester")
  catalogRequestVotes             CatalogRequestVote[]
  reviewedCatalogRequests         CatalogRequest[]         @relation("CatalogRequestReviewer")
  performedAuditLogs              AuditLog[]
  updatedSettings                 GlobalSetting[]
  sentGlobalNotifications         GlobalNotification[]
  reportExports                   ReportExport[]
  notifications                   Notification[]
  refreshTokens                   RefreshToken[]
  passwordResetTokens             PasswordResetToken[]
  sellerVerification              SellerVerification?      @relation("SellerVerificationSeller")
  reviewedVerifications           SellerVerification[]     @relation("SellerVerificationReviewer")
  validatedSellerDocuments        SellerDocument[]         @relation("SellerDocumentValidator")
  authoredSellerVerificationNotes SellerVerificationNote[] @relation("SellerVerificationNoteAuthor")
  addresses                       Address[]
  warningsReceived                UserWarning[]            @relation("UserWarningTarget")
  warningsGiven                   UserWarning[]            @relation("UserWarningAdmin")
  listings                        Listing[]
  purchases                       Order[]                  @relation("OrderBuyer")
  sales                           Order[]                  @relation("OrderSeller")
  collection                      Collection?

  @@unique([oauthProvider, oauthId], map: "users_oauth_provider_oauth_id_key")
  @@map("users")
}

model Profile {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  bio              String?
  avatarUrl        String?   @map("avatar_url") @db.VarChar(255)
  city             String?   @db.VarChar(120)
  portfolioPrivacy Privacy   @default(PUBLIC) @map("portfolio_privacy")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_profiles_user_id")

  @@map("profiles")
}

model Address {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  label        String    @db.VarChar(60)
  zipCode      String    @map("zip_code") @db.VarChar(9)
  street       String    @db.VarChar(160)
  number       String    @db.VarChar(15)
  complement   String?   @db.VarChar(60)
  neighborhood String    @db.VarChar(90)
  city         String    @db.VarChar(90)
  state        String    @db.Char(2)
  isPrimary    Boolean   @default(false) @map("is_primary")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user                User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_addresses_user_id")
  sellerVerifications SellerVerification[]
  orders              Order[]

  @@map("addresses")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  used      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_password_reset_tokens_user_id")

  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_refresh_tokens_user_id")

  @@map("refresh_tokens")
}

model Category {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parentCategoryId String?   @map("parent_category_id") @db.Uuid
  name             String    @db.VarChar(90)
  description      String?   @db.VarChar(255)
  isDefault        Boolean   @default(false) @map("is_default")
  slug             String?   @db.VarChar(100)
  displayOrder     Int       @default(0) @map("display_order")
  isPinned         Boolean   @default(false) @map("is_pinned")
  badge            String?   @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  parentCategory Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_categories_parent_category_id")
  subcategories  Category[] @relation("CategoryHierarchy")
  albums         Album[]
  cards          Card[]

  @@unique([slug], map: "categories_slug_key", where: raw("deleted_at IS NULL"))
  @@map("categories")
}

model Rarity {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String    @unique @db.VarChar(60)
  sortOrder Int       @map("sort_order") @db.SmallInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  cards Card[]

  @@map("rarities")
}

model Language {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String    @db.VarChar(60)
  code      String    @unique @db.VarChar(5)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  cards Card[]

  @@map("languages")
}

enum AlbumStatus {
  ACTIVE
  INACTIVE

  @@map("album_status")
}

model Album {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId  String?     @map("category_id") @db.Uuid
  title       String      @db.VarChar(160)
  publisher   String?     @db.VarChar(120)
  year        Int?        @db.SmallInt
  description String?
  coverUrl    String?     @map("cover_url") @db.VarChar(255)
  totalCards  Int         @default(0) @map("total_cards")
  status      AlbumStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(6)

  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_albums_category_id")
  cards           Card[]
  catalogRequests CatalogRequest[]
  userAlbums      UserAlbum[]

  @@map("albums")
}

model Card {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  albumId       String?   @map("album_id") @db.Uuid
  categoryId    String?   @map("category_id") @db.Uuid
  rarityId      String?   @map("rarity_id") @db.Uuid
  languageId    String?   @map("language_id") @db.Uuid
  name          String    @db.VarChar(160)
  number        String?   @db.VarChar(20)
  description   String?
  frontImageUrl String?   @map("front_image_url") @db.VarChar(255)
  backImageUrl  String?   @map("back_image_url") @db.VarChar(255)
  code          String?   @db.VarChar(30)
  variants      String?   @db.VarChar(120)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  album           Album?           @relation(fields: [albumId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cards_album_id")
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cards_category_id")
  rarity          Rarity?          @relation(fields: [rarityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cards_rarity_id")
  language        Language?        @relation(fields: [languageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cards_language_id")
  photos          CardPhoto[]
  groupMessages   GroupMessage[]
  catalogRequests CatalogRequest[]
  listings        Listing[]
  priceHistory    PriceHistory[]
  collectionCards CollectionCard[]

  @@unique([albumId, number])
  @@unique([code], map: "cards_code_key", where: raw("deleted_at IS NULL"))
  @@map("cards")
}

model CardPhoto {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cardId    String    @map("card_id") @db.Uuid
  url       String    @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  card Card @relation(fields: [cardId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_card_photos_card_id")

  @@map("card_photos")
}

enum GroupAccessType {
  OPEN
  CLOSED

  @@map("group_access_type")
}

enum GroupStatus {
  ACTIVE
  WARNED
  SUSPENDED

  @@map("group_status")
}

model Group {
  id            String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  creatorId     String          @map("creator_id") @db.Uuid
  name          String          @db.VarChar(120)
  description   String?
  coverImageUrl String?         @map("cover_image_url") @db.VarChar(255)
  accessType    GroupAccessType @map("access_type")
  status        GroupStatus     @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)

  creator  User           @relation(fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_groups_creator_id")
  members  GroupMember[]
  messages GroupMessage[]

  @@map("groups")
}

enum MemberRole {
  MEMBER
  ADMIN

  @@map("member_role")
}

model GroupMember {
  id         String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId    String     @map("group_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  role       MemberRole @default(MEMBER)
  mutedUntil DateTime?  @map("muted_until") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_group_members_group_id")
  user  User  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_group_members_user_id")

  @@unique([groupId, userId])
  @@map("group_members")
}

enum MessageContentType {
  TEXT
  IMAGE
  CARD
  LISTING
  POLL

  @@map("message_content_type")
}

model GroupMessage {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId       String             @map("group_id") @db.Uuid
  authorId      String             @map("author_id") @db.Uuid
  replyToId     String?            @map("reply_to_id") @db.Uuid
  cardId        String?            @map("card_id") @db.Uuid
  listingId     String?            @map("listing_id") @db.Uuid
  contentType   MessageContentType @default(TEXT) @map("content_type")
  content       String?
  attachmentUrl String?            @map("attachment_url") @db.VarChar(255)
  pinned        Boolean            @default(false)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz(6)

  group   Group          @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_group_messages_group_id")
  author  User           @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_group_messages_author_id")
  replyTo GroupMessage?  @relation("GroupMessageReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_group_messages_reply_to_id")
  replies GroupMessage[] @relation("GroupMessageReplies")
  card    Card?          @relation(fields: [cardId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_group_messages_card_id")
  listing Listing?       @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_group_messages_listing_id")
  reports Report[]

  @@map("group_messages")
}

enum ReportTargetType {
  LISTING
  SELLER
  USER
  PROFILE
  GROUP_MESSAGE

  @@map("report_target_type")
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED

  @@map("report_status")
}

model Report {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  moderatorId    String?          @map("moderator_id") @db.Uuid
  listingId      String?          @map("listing_id") @db.Uuid
  targetUserId   String?          @map("target_user_id") @db.Uuid
  groupMessageId String?          @map("group_message_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  reason         String           @db.VarChar(90)
  description    String?          @db.VarChar(500)
  status         ReportStatus     @default(PENDING)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  reporter     User          @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reports_reporter_id")
  moderator    User?         @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reports_moderator_id")
  targetUser   User?         @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reports_target_user_id")
  groupMessage GroupMessage? @relation(fields: [groupMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reports_group_message_id")
  listing      Listing?      @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reports_listing_id")
  warnings     UserWarning[]

  @@map("reports")
}

model UserWarning {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  reportId  String?   @map("report_id") @db.Uuid
  reason    String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user   User    @relation("UserWarningTarget", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_warnings_user_id")
  admin  User    @relation("UserWarningAdmin", fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_warnings_admin_id")
  report Report? @relation(fields: [reportId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_warnings_report_id")

  @@map("user_warnings")
}

enum CatalogRequestType {
  CARD
  ALBUM
  CATEGORY

  @@map("catalog_request_type")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("request_status")
}

model CatalogRequest {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requesterId  String             @map("requester_id") @db.Uuid
  reviewedById String?            @map("reviewed_by_id") @db.Uuid
  cardId       String?            @map("card_id") @db.Uuid
  albumId      String?            @map("album_id") @db.Uuid
  type         CatalogRequestType
  data         Json               @db.JsonB
  status       RequestStatus      @default(PENDING)
  reviewedAt   DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)

  requester  User                 @relation("CatalogRequestRequester", fields: [requesterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_requests_requester_id")
  reviewedBy User?                @relation("CatalogRequestReviewer", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_requests_reviewed_by_id")
  card       Card?                @relation(fields: [cardId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_requests_card_id")
  album      Album?               @relation(fields: [albumId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_requests_album_id")
  votes      CatalogRequestVote[]

  @@map("catalog_requests")
}

enum CatalogVote {
  FOR
  NEUTRAL
  AGAINST

  @@map("catalog_vote")
}

/// Um voto por cliente em cada solicitação (CCD103, ADR-053).
model CatalogRequestVote {
  catalogRequestId String      @map("catalog_request_id") @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  vote             CatalogVote
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)

  catalogRequest CatalogRequest @relation(fields: [catalogRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_request_votes_catalog_request_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_request_votes_user_id")

  @@id([catalogRequestId, userId])
  @@map("catalog_request_votes")
}

model AuditLog {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  action     String    @db.VarChar(90)
  entityType String    @map("entity_type") @db.VarChar(60)
  entityId   String?   @map("entity_id") @db.Uuid
  details    Json?     @db.JsonB
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  admin User @relation(fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_logs_admin_id")

  @@map("audit_logs")
}

model GlobalSetting {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  key         String    @unique @db.VarChar(90)
  value       String
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

