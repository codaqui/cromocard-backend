# Copie para .env e ajuste. Valores FICTÍCIOS, só para o ambiente local.
# Em homologação e produção, o .env é gerado pelo deploy a partir dos secrets
# do GitHub (ver docs/runbooks/segredos.md). Nunca coloque um valor real aqui.
NODE_ENV=development
# Qual ambiente é (ADR-018): local, test, homolog ou production
APP_ENV=local
PORT=3000
# Lista separada por vírgula; o mesmo nome usado no Compose e nos Environments do GitHub
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
# Banco local do docker-compose.yml da raiz (PostgreSQL 18)
DATABASE_URL=postgresql://cromocard:cromocard@localhost:5432/cromocard
# Mínimo de 32 caracteres; gere o seu com: openssl rand -hex 32
JWT_SECRET=exemplo-local-exemplo-local-exemplo-local
# Validade dos tokens, em segundos: access 15 min, refresh 1 dia e 30 dias com "lembrar de mim" (ADR-005)
JWT_ACCESS_TTL=900
REFRESH_TTL=86400
REFRESH_TTL_REMEMBER=2592000
# Client ID do Google Identity Services, o mesmo do frontend; não é segredo (ADR-048). Vazio desliga o login com Google
GOOGLE_CLIENT_ID=exemplo.apps.googleusercontent.com
# Cookie do refresh só por HTTPS; false só no ambiente local, que roda em http
COOKIE_SECURE=false
# Proxies na frente da API que repassam o IP do cliente; 0 no local, 1 atrás do cloudflared (hml e prod)
TRUST_PROXY=0
# Liga os jobs agendados (node-cron, ADR-010), como a limpeza diária dos tokens expirados; só numa instância da API
JOBS_ENABLED=false
# E-mail (ADR-009): "ethereal" no dev (o link de cada e-mail sai no log), "smtp" com um servidor real
MAIL_DRIVER=ethereal
MAIL_FROM=CromoCard <nao-responda@cromocard.com.br>
# Só com MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Endereço público da API, usado para montar a URL dos arquivos enviados (ADR-009); obrigatório em produção
API_PUBLIC_URL=http://localhost:3000
# Endereço do frontend, base dos links enviados por e-mail; sem ele, vale o primeiro CORS_ORIGIN
FRONTEND_URL=http://localhost:5173
# Validade do link de confirmação de e-mail, em segundos (86400 = 24 horas, ADR-048)
EMAIL_VERIFICATION_TTL=86400
# Validade do link de redefinição de senha, em segundos (3600 = 1 hora, ADR-048)
PASSWORD_RESET_TTL=3600
# Validade do link de convite de um usuário criado pelo admin, em segundos (86400 = 24 horas, CCD098 R5)
INVITE_TTL=86400
# Onde ficam os arquivos enviados: só "local" por enquanto (S3 depois, ADR-009)
STORAGE_DRIVER=local
# Pasta onde o storage local grava os uploads; servida em /uploads
STORAGE_LOCAL_DIR=uploads
# Pasta dos arquivos privados (relatórios exportados, CCD107); nunca é servida em /uploads
STORAGE_LOCAL_PRIVATE_DIR=storage-private
# Pagamento do marketplace (ADR-066, CCD072): "fake" no PC e nos testes (a página de pagamento é a própria volta),
# "stripe" em homologação e produção; produção (APP_ENV=production) recusa o fake
PAYMENT_DRIVER=fake
# Só com PAYMENT_DRIVER=stripe: chave secreta (sk_test_… em homologação) e segredo do endpoint do webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Segredo do destino de webhook das contas conectadas (account.updated, CCD108); no PC, com o "stripe listen", fica vazio
STRIPE_CONNECT_WEBHOOK_SECRET=
# Frete do marketplace (ADR-067, CCD072): "fake" (Correios e Jadlog com preço fixo; o CEP 99999-999 fica sem frete)
# ou "melhor-envio"; produção recusa o fake
SHIPPING_DRIVER=fake
# Só com SHIPPING_DRIVER=melhor-envio: token do painel e a base (sandbox em homologação)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
