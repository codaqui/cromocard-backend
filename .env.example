# Copie para .env e ajuste. Valores FICTÍCIOS, só para o ambiente local.
# Em homologação e produção, o .env é gerado pelo deploy a partir dos secrets
# do GitHub (ver docs/runbooks/segredos.md). Nunca coloque um valor real aqui.
NODE_ENV=development
PORT=3000
# Lista separada por vírgula; o mesmo nome usado no Compose e nos Environments do GitHub
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
# Banco local do docker-compose.yml da raiz (PostgreSQL 18)
DATABASE_URL=postgresql://cromocard:cromocard@localhost:5432/cromocard
# Mínimo de 32 caracteres; gere o seu com: openssl rand -hex 32
JWT_SECRET=exemplo-local-exemplo-local-exemplo-local
# Validade dos tokens, em segundos: access 15 min, refresh 1 dia e 30 dias com "lembrar de mim" (ADR-005)
JWT_ACCESS_TTL=900
REFRESH_TTL=86400
REFRESH_TTL_REMEMBER=2592000
# Client ID do Google Identity Services, o mesmo do frontend; não é segredo (ADR-048)
GOOGLE_CLIENT_ID=exemplo.apps.googleusercontent.com
# Cookie do refresh só por HTTPS; false só no ambiente local, que roda em http
COOKIE_SECURE=false
# Liga os jobs agendados (node-cron, ADR-010), como a limpeza diária dos tokens expirados; só numa instância da API
JOBS_ENABLED=false
# E-mail (ADR-009): "ethereal" no dev (o link de cada e-mail sai no log), "smtp" com um servidor real
MAIL_DRIVER=ethereal
MAIL_FROM=CromoCard <nao-responda@cromocard.com.br>
# Só com MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Endereço público da API, usado para montar a URL dos arquivos enviados (ADR-009); obrigatório em produção
API_PUBLIC_URL=http://localhost:3000
# Endereço do frontend, base dos links enviados por e-mail; sem ele, vale o primeiro CORS_ORIGIN
FRONTEND_URL=http://localhost:5173
# Validade do link de confirmação de e-mail, em segundos (86400 = 24 horas, ADR-048)
EMAIL_VERIFICATION_TTL=86400
# Validade do link de redefinição de senha, em segundos (3600 = 1 hora, ADR-048)
PASSWORD_RESET_TTL=3600
# Onde ficam os arquivos enviados: só "local" por enquanto (S3 depois, ADR-009)
STORAGE_DRIVER=local
# Pasta onde o storage local grava os uploads; servida em /uploads
STORAGE_LOCAL_DIR=uploads
